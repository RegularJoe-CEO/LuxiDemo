.version 7.5
.target sm_89
.address_size 64

.entry f32_sincos_kernel(
	.param .u64 input_ptr,
	.param .u64 sin_ptr,
	.param .u64 cos_ptr,
	.param .u32 n
) {
	.reg .b32 	%r<5>;
	.reg .f32 	%f<4>;
	.reg .pred 	%p<1>;

	ld.param.u32 	%r1, [n];
	ld.param.u64 	%r2, [input_ptr];
	ld.param.u64 	%r3, [sin_ptr];
	ld.param.u64 	%r4, [cos_ptr];

	mov.u32 	%r0, 0;

loop:
	setp.ge.s32 	%p0, %r0, %r1;
	@%p0 exit;

	ld.global.f32 	%f0, [%r2 + %r0 * 4];
	sinf.approx.ftz.f32 %f1, %f0;
	cosf.approx.ftz.f32 %f2, %f0;
	st.global.f32 	[%r3 + %r0 * 4], %f1;
	st.global.f32 	[%r4 + %r0 * 4], %f2;
	add.s32 	%r0, %r0, 1;
	bra loop;

exit:
	ret;
}

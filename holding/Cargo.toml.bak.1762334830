[package]
name = "luxi"
version = "0.1.0"
edition = "2021"

[dependencies]
actix-web = "4"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["full"] }
rhai = { version = "1", features = ["decimal"] }
env_logger = "0.11"
anyhow = "1"

[[bin]]
name = "luxi"
path = "src/main.rs"

openapi: 3.0.3
info:
  title: Luxi Edge API
  version: "0.1.5"
  description: >
    Public contract for Luxi Edge numeric microservice.

    Notes:
      - The `rhai` engine treats `^` as XOR. Use `x*x` for squares.
      - PR‑05 introduces an optional precision negotiation parameter (`precision`) for forward-compatibility.
        Current server builds compute in f64; `f32` and `auto` may be ignored by older servers.
  license:
    name: LicenseRef-Luxi-Business-1.0
servers:
  - url: http://localhost:8080

tags:
  - name: health
  - name: evaluate
  - name: bisect
  - name: bisect_auto

components:
  parameters:
    PrecisionQuery:
      name: precision
      in: query
      description: >
        Optional requested numeric precision. Values:
        - f64 (default): 64-bit float
        - f32: 32-bit float
        - auto: server decides based on workload/hardware
        Backward-compatible: older servers simply ignore this parameter.
      required: false
      schema:
        type: string
        enum: [f64, f32, auto]
        default: f64

  schemas:
    ErrorResponse:
      type: object
      properties:
        code: { type: string, example: "BadRequest" }
        message: { type: string, example: "invalid payload" }
        details: { type: object, additionalProperties: true }
      required: [code, message]

    EvaluateRequest:
      type: object
      properties:
        expression:
          type: string
          example: "x*x + 2*x + 1"
        x:
          type: number
          format: double
          example: 3.0
      required: [expression, x]

    EvaluateResponse:
      type: object
      properties:
        result:
          type: number
          format: double
          example: 16.0

    BisectRequest:
      type: object
      properties:
        expression:
          type: string
          example: "x*x - x - 1"
        a:
          type: number
          format: double
          example: 0.0
        b:
          type: number
          format: double
          example: 2.0
        tolerance:
          type: number
          format: double
          example: 1e-9
      required: [expression, a, b]

    BisectResponse:
      type: object
      properties:
        bracket_ok: { type: boolean, example: true }
        root: { type: number, format: double, nullable: true, example: 1.6180339887 }
        iterations: { type: integer, example: 45 }

    BisectAutoRequest:
      type: object
      properties:
        expression:
          type: string
          example: "x*x - 2"
        tolerance:
          type: number
          format: double
          example: 1e-9
      required: [expression]

    BisectAutoResponse:
      type: object
      properties:
        bracket_ok: { type: boolean, example: true }
        root: { type: number, format: double, nullable: true, example: 1.41421356237 }
        iterations: { type: integer, example: 60 }

paths:
  /health:
    get:
      tags: [health]
      summary: Liveness/health check
      responses:
        "200":
          description: OK

  /evaluate:
    post:
      tags: [evaluate]
      summary: Evaluate an expression at a given x
      description: |
        Evaluate expression using the Luxi engine.
        Tip: `^` is XOR in rhai; use `x*x` for squares.
      parameters:
        - $ref: '#/components/parameters/PrecisionQuery'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EvaluateRequest'
            examples:
              default:
                value: { expression: "x*x + 2*x + 1", x: 3.0 }
              with_precision:
                summary: Request f32 (older servers may ignore)
                value: { expression: "x*x + 2*x + 1", x: 3.0 }
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/EvaluateResponse'
              examples:
                ok:
                  value: { result: 16.0 }
        "400":
          description: Bad request
          content: { application/json: { schema: { $ref: '#/components/schemas/ErrorResponse' } } }
        "500":
          description: Server error
          content: { application/json: { schema: { $ref: '#/components/schemas/ErrorResponse' } } }

  /bisect:
    post:
      tags: [bisect]
      summary: Bisection root finding on [a, b]
      description: |
        Returns `bracket_ok` plus the estimated `root` when signs differ on [a,b].
      parameters:
        - $ref: '#/components/parameters/PrecisionQuery'
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/BisectRequest' }
            examples:
              default:
                value: { expression: "x*x - x - 1", a: 0.0, b: 2.0, tolerance: 1e-9 }
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema: { $ref: '#/components/schemas/BisectResponse' }
              examples:
                ok:
                  value: { bracket_ok: true, root: 1.6180339887, iterations: 45 }
        "400":
          description: Bad request
          content: { application/json: { schema: { $ref: '#/components/schemas/ErrorResponse' } } }
        "500":
          description: Server error
          content: { application/json: { schema: { $ref: '#/components/schemas/ErrorResponse' } } }

  /bisect_auto:
    post:
      tags: [bisect_auto]
      summary: Bisection with automatic bracketing
      parameters:
        - $ref: '#/components/parameters/PrecisionQuery'
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/BisectAutoRequest' }
            examples:
              default:
                value: { expression: "x*x - 2", tolerance: 1e-9 }
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema: { $ref: '#/components/schemas/BisectAutoResponse' }
              examples:
                ok:
                  value: { bracket_ok: true, root: 1.41421356237, iterations: 60 }
        "400":
          description: Bad request
          content: { application/json: { schema: { $ref: '#/components/schemas/ErrorResponse' } } }
        "500":
          description: Server error
          content: { application/json: { schema: { $ref: '#/components/schemas/ErrorResponse' } } }
